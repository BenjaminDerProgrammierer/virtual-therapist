generator client {
    provider = "prisma-client-py"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Conversations {
    id     Int @id @default(autoincrement())
    userId Int
}

model Messages {
    id             Int      @id @default(autoincrement())
    conversationId Int
    role           String
    content        String
    createdAt      DateTime @default(now())
}
